#!/usr/bin/env bash
set -euo pipefail

rm -rf Watermarker.app
mkdir -p Watermarker.app/Contents/MacOS/
cp target/watermarker Watermarker.app/Contents/MacOS/Watermarker
mkdir -p Watermarker.app/Contents/Resources/
cp -R src/main/ruby/ Watermarker.app/Contents/Resources/
cp Gemfile Watermarker.app/Contents/Resources/
cp Gemfile.lock Watermarker.app/Contents/Resources/
cp Watermarker.icns Watermarker.app/Contents/Resources/
cp Info.plist Watermarker.app/Contents/

pushd Watermarker.app/Contents/Resources
BUNDLE_PATH=./vendor/bundle bundle install
BUNDLE_PATH=./vendor/bundle bundle exec ruby -rjson -e "puts Gem.loaded_specs.each_value.flat_map(&:full_require_paths).select { |path| path.start_with?(Dir.getwd) }.map { |path| path.delete_prefix(Dir.getwd + '/') }.to_json" > bundle_paths.json
popd

find Watermarker.app/Contents/Resources/vendor/bundle -type f -name '*.o' -delete
xattr -cr Watermarker.app

codesign --force --sign - --identifier com.camertron.watermarker Watermarker.app/Contents/MacOS/Watermarker
while IFS= read -r -d '' native_extension; do
  codesign --force --sign - "$native_extension"
done < <(find Watermarker.app -type f \( -name '*.bundle' -o -name '*.dylib' \) -print0)

codesign --force --sign - --identifier com.camertron.watermarker Watermarker.app
codesign --verify --deep --strict --verbose=4 Watermarker.app
